<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NEXOSalud by RHINOBUILD</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js"></script>
<style>
  :root{
    --bg:#F3F6F5;
    --surface:#FFFFFF;
    --ink:#121A1C;
    --ink-soft:#556063;
    --ink-faint:#8A9497;
    --line:#DCE4E2;
    --line-soft:#EAEFEE;
    --brand:#0F6B66;
    --brand-ink:#0B4C48;
    --brand-soft:#E1F0ED;
    --warn:#B3441E;
    --radius-s:4px;
    --radius-m:8px;
    --serif:'Source Serif 4', Georgia, serif;
    --sans:'Public Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;height:100%;}
  body{
    font-family:var(--sans);
    background:var(--bg);
    color:var(--ink);
    -webkit-font-smoothing:antialiased;
  }
  button{font-family:inherit;}
  ::selection{background:var(--brand-soft);}

  .app{display:flex;min-height:100vh;}

  /* Sidebar */
  .sidebar{
    width:216px;
    flex-shrink:0;
    background:var(--surface);
    border-right:1px solid var(--line);
    display:flex;
    flex-direction:column;
    padding:20px 14px;
    position:sticky;
    top:0;
    height:100vh;
  }
  .brandmark{display:flex;align-items:center;gap:10px;padding:4px 8px 22px 8px;}
  .brandmark .mark-img{width:30px;height:30px;border-radius:7px;object-fit:contain;flex-shrink:0;}
  .brandmark .word-wrap{display:flex;flex-direction:column;line-height:1.15;}
  .brandmark .word{font-weight:700;font-size:14.5px;letter-spacing:-0.01em;}
  .brandmark .word b{color:var(--brand);}
  .brandmark .by{font-size:9.5px;color:var(--ink-faint);font-weight:600;letter-spacing:.03em;margin-top:1px;}
  nav.navlist{display:flex;flex-direction:column;gap:1px;flex:1;}
  .navlist button{
    all:unset;
    display:flex;align-items:center;gap:10px;
    padding:9px 10px;border-radius:var(--radius-s);
    font-size:13.5px;color:var(--ink-soft);cursor:pointer;
    font-weight:500;
  }
  .navlist button:hover{background:var(--line-soft);color:var(--ink);}
  .navlist button.active{background:var(--brand-soft);color:var(--brand-ink);font-weight:600;}
  .navlist .dot{width:5px;height:5px;border-radius:50%;background:currentColor;opacity:.55;flex-shrink:0;}
  .sidebar-foot{padding:10px 8px 0 8px;border-top:1px solid var(--line-soft);margin-top:10px;font-size:11.5px;color:var(--ink-faint);}

  /* Main */
  .main{flex:1;min-width:0;display:flex;flex-direction:column;}
  .topbar{
    display:flex;align-items:center;justify-content:space-between;
    padding:16px 34px;border-bottom:1px solid var(--line);
    background:var(--bg);
  }
  .topbar .eyebrow{font-size:12px;color:var(--ink-faint);font-weight:600;letter-spacing:.02em;}
  .topbar .greet{font-family:var(--serif);font-size:19px;margin-top:1px;}
  .avatar{
    width:32px;height:32px;border-radius:50%;background:#fff;
    color:#fff;display:flex;align-items:center;justify-content:center;
    font-size:12px;font-weight:700;flex-shrink:0;
    border:1px solid var(--line);object-fit:contain;padding:3px;
  }
  .view{padding:30px 34px 60px 34px;max-width:1080px;}

  /* Home stats */
  .stat-row{display:flex;gap:1px;background:var(--line);border:1px solid var(--line);border-radius:var(--radius-m);overflow:hidden;margin-bottom:36px;}
  .stat{flex:1;background:var(--surface);padding:18px 20px;}
  .stat .n{font-family:var(--serif);font-size:30px;line-height:1;}
  .stat .l{font-size:12.5px;color:var(--ink-soft);margin-top:7px;}

  h2.sec{font-family:var(--serif);font-size:20px;font-weight:600;margin:0 0 14px 0;}
  .sec-row{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:14px;}
  .sec-row .link{font-size:12.5px;color:var(--brand-ink);cursor:pointer;font-weight:600;}

  .company-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:40px;}
  .company-card{
    border:1px solid var(--line);border-radius:var(--radius-m);
    padding:16px;background:var(--surface);cursor:pointer;
  }
  .company-card .chip{
    width:34px;height:34px;border-radius:8px;display:flex;align-items:center;justify-content:center;
    font-weight:800;font-size:13px;color:#fff;margin-bottom:12px;
  }
  .company-card .name{font-weight:700;font-size:14.5px;}
  .company-card .meta{font-size:12px;color:var(--ink-soft);margin-top:2px;}

  .course-list{display:flex;flex-direction:column;border-top:1px solid var(--line);}
  .course-row{
    display:flex;align-items:center;gap:14px;padding:14px 4px;
    border-bottom:1px solid var(--line);cursor:pointer;
  }
  .course-row:hover .cr-title{color:var(--brand-ink);}
  .cr-badge{
    width:38px;height:38px;border-radius:8px;flex-shrink:0;
    display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:12px;
  }
  .cr-body{flex:1;min-width:0;}
  .cr-title{font-weight:600;font-size:14px;}
  .cr-meta{font-size:12px;color:var(--ink-soft);margin-top:2px;}
  .cr-status{font-size:11px;font-weight:700;letter-spacing:.02em;padding:3px 8px;border-radius:20px;flex-shrink:0;}
  .cr-status.listo{background:#E4F3E8;color:#276B3D;}
  .cr-status.borrador{background:#FBF0DD;color:#8A5A17;}
  .cr-dl{
    border:1px solid var(--line);background:var(--surface);color:var(--ink-soft);
    border-radius:50%;width:30px;height:30px;flex-shrink:0;cursor:pointer;font-size:13px;
    display:flex;align-items:center;justify-content:center;
  }
  .cr-dl:hover{background:var(--line-soft);color:var(--ink);}

  .empty{padding:40px 10px;text-align:center;color:var(--ink-faint);font-size:13.5px;border:1px dashed var(--line);border-radius:var(--radius-m);}

  /* Wizard */
  .wizard{max-width:660px;}
  .steps{display:flex;gap:8px;margin-bottom:28px;}
  .steps .s{flex:1;height:3px;border-radius:2px;background:var(--line);}
  .steps .s.done{background:var(--brand);}
  .steps .s.now{background:var(--brand);opacity:.45;}
  .step-label{font-size:12px;color:var(--ink-faint);font-weight:600;margin-bottom:6px;}
  .step-title{font-family:var(--serif);font-size:23px;margin:0 0 22px 0;}

  .dropzone{
    border:1.5px dashed var(--line);border-radius:var(--radius-m);
    padding:38px 24px;text-align:center;cursor:pointer;background:var(--surface);
  }
  .dropzone:hover{border-color:var(--brand);background:var(--brand-soft);}
  .dropzone .ic{font-size:22px;margin-bottom:10px;}
  .dropzone .t1{font-weight:600;font-size:14px;}
  .dropzone .t2{font-size:12px;color:var(--ink-soft);margin-top:4px;}
  .file-chip{
    display:flex;align-items:center;gap:12px;border:1px solid var(--line);border-radius:var(--radius-m);
    padding:13px 16px;background:var(--surface);
  }
  .file-chip .ic{
    width:32px;height:32px;border-radius:7px;background:var(--brand-soft);color:var(--brand-ink);
    display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;
  }
  .file-chip .name{font-weight:600;font-size:13.5px;}
  .file-chip .sub{font-size:11.5px;color:var(--ink-soft);margin-top:1px;}
  .file-chip .x{margin-left:auto;background:none;border:none;color:var(--ink-faint);cursor:pointer;font-size:13px;}

  .opt-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:6px;}
  .opt-card{
    border:1.5px solid var(--line);border-radius:var(--radius-m);padding:16px;cursor:pointer;background:var(--surface);
  }
  .opt-card.sel{border-color:var(--brand);background:var(--brand-soft);}
  .opt-card .t{font-weight:700;font-size:14px;}
  .opt-card .d{font-size:12px;color:var(--ink-soft);margin-top:4px;line-height:1.4;}

  .company-pick{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:6px;}
  .company-pick .cp{
    border:1.5px solid var(--line);border-radius:var(--radius-m);padding:14px 10px;text-align:center;cursor:pointer;background:var(--surface);
  }
  .company-pick .cp.sel{border-color:var(--brand);background:var(--brand-soft);}
  .company-pick .chip{width:30px;height:30px;border-radius:7px;margin:0 auto 8px auto;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:11.5px;}
  .company-pick .name{font-size:12.5px;font-weight:600;}

  .field-label{font-size:12.5px;font-weight:600;color:var(--ink-soft);margin:22px 0 8px 0;}
  .wizard-actions{display:flex;justify-content:space-between;align-items:center;margin-top:30px;}
  .btn{
    border:none;border-radius:var(--radius-s);padding:10px 18px;font-size:13.5px;font-weight:600;cursor:pointer;
  }
  .btn-primary{background:var(--ink);color:#fff;}
  .btn-primary:disabled{background:var(--line);color:var(--ink-faint);cursor:not-allowed;}
  .btn-ghost{background:none;color:var(--ink-soft);}
  .btn-ghost:hover{color:var(--ink);}

  .review-box{border:1px solid var(--line);border-radius:var(--radius-m);padding:18px 20px;background:var(--surface);margin-top:4px;}
  .review-row{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--line-soft);font-size:13px;}
  .review-row:last-child{border-bottom:none;}
  .review-row .k{color:var(--ink-soft);}
  .review-row .v{font-weight:600;}

  /* Progress */
  .progress-wrap{padding:60px 10px;text-align:center;}
  .progress-wrap .spin{
    width:34px;height:34px;border-radius:50%;border:3px solid var(--line);border-top-color:var(--brand);
    margin:0 auto 22px auto;animation:spin .8s linear infinite;
  }
  @keyframes spin{to{transform:rotate(360deg);}}
  .progress-wrap .msg{font-family:var(--serif);font-size:18px;}
  .progress-wrap .sub{font-size:12.5px;color:var(--ink-soft);margin-top:8px;}
  .progress-bar{width:280px;height:4px;background:var(--line);border-radius:3px;margin:22px auto 0 auto;overflow:hidden;}
  .progress-bar .fill{height:100%;background:var(--brand);transition:width .4s ease;}

  /* Course viewer */
  .course-head{
    display:flex;align-items:center;gap:14px;margin-bottom:26px;padding-bottom:22px;border-bottom:1px solid var(--line);
  }
  .course-head .grow{flex:1;min-width:0;}
  .download-group{display:flex;gap:8px;flex-shrink:0;}
  .btn-dl{
    border:1px solid var(--line);background:var(--surface);color:var(--ink-soft);
    border-radius:var(--radius-s);padding:8px 13px;font-size:12.5px;font-weight:600;cursor:pointer;
    display:flex;align-items:center;gap:6px;
  }
  .btn-dl:hover{background:var(--line-soft);color:var(--ink);}
  .course-head .chip{width:44px;height:44px;border-radius:9px;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:14px;flex-shrink:0;}
  .course-head .title{font-family:var(--serif);font-size:24px;margin:0;}
  .course-head .meta{font-size:12.5px;color:var(--ink-soft);margin-top:3px;}
  .course-body{display:flex;gap:36px;align-items:flex-start;}
  .module-nav{width:220px;flex-shrink:0;display:flex;flex-direction:column;gap:2px;position:sticky;top:26px;}
  .module-nav button{
    all:unset;text-align:left;padding:9px 11px;border-radius:var(--radius-s);font-size:12.5px;cursor:pointer;color:var(--ink-soft);
    display:flex;gap:9px;align-items:flex-start;
  }
  .module-nav button .num{font-weight:700;color:var(--ink-faint);flex-shrink:0;}
  .module-nav button.active{background:var(--brand-soft);color:var(--brand-ink);font-weight:600;}
  .module-nav button.active .num{color:var(--brand-ink);}
  .module-nav button:hover:not(.active){background:var(--line-soft);}
  .content-pane{flex:1;min-width:0;max-width:620px;}
  .content-pane h3{font-family:var(--serif);font-size:20px;margin:0 0 14px 0;}
  .content-pane .body-text{font-size:14.5px;line-height:1.75;color:#212B2D;}
  .content-pane .body-text p{margin:0 0 14px 0;}
  .content-pane .body-text ul{margin:0 0 14px 0;padding-left:20px;}
  .content-pane .body-text li{margin-bottom:6px;}
  .content-pane .body-text strong{color:var(--ink);}
  .content-nav{display:flex;justify-content:space-between;margin-top:30px;padding-top:20px;border-top:1px solid var(--line-soft);}

  /* Quiz */
  .quiz-q{border:1px solid var(--line);border-radius:var(--radius-m);padding:16px 18px;margin-bottom:12px;background:var(--surface);}
  .quiz-q .qtext{font-weight:600;font-size:13.5px;margin-bottom:11px;}
  .quiz-opt{display:flex;align-items:center;gap:9px;padding:8px 10px;border-radius:var(--radius-s);cursor:pointer;font-size:13px;border:1px solid var(--line-soft);margin-bottom:6px;}
  .quiz-opt:hover{background:var(--line-soft);}
  .quiz-opt.picked{border-color:var(--brand);background:var(--brand-soft);}
  .quiz-opt.correct{border-color:#3C8A57;background:#E4F3E8;}
  .quiz-opt.wrong{border-color:var(--warn);background:#FBEAE3;}
  .quiz-result{padding:20px;text-align:center;border:1px solid var(--line);border-radius:var(--radius-m);background:var(--surface);}
  .quiz-result .score{font-family:var(--serif);font-size:32px;}

  /* Presentation viewer */
  .slide-frame{
    border:1px solid var(--line);border-radius:var(--radius-m);background:var(--surface);
    aspect-ratio:16/9;padding:44px 50px;display:flex;flex-direction:column;justify-content:center;position:relative;overflow:hidden;
  }
  .slide-frame .bar{position:absolute;top:0;left:0;right:0;height:6px;}
  .slide-frame h3{font-family:var(--serif);font-size:26px;margin:0 0 18px 0;}
  .slide-frame ul{font-size:15px;line-height:1.7;padding-left:20px;margin:0;}
  .slide-frame li{margin-bottom:8px;}
  .slide-controls{display:flex;align-items:center;justify-content:center;gap:16px;margin-top:18px;}
  .slide-controls .idx{font-size:12.5px;color:var(--ink-soft);min-width:56px;text-align:center;}
  .icon-btn{border:1px solid var(--line);background:var(--surface);border-radius:50%;width:32px;height:32px;cursor:pointer;font-size:14px;}
  .icon-btn:hover{background:var(--line-soft);}
  .icon-btn:disabled{opacity:.35;cursor:not-allowed;}

  .err-box{border:1px solid #E6BBA8;background:#FBEAE3;color:#8A3016;border-radius:var(--radius-m);padding:12px 16px;font-size:13px;margin-top:16px;}
</style>
</head>
<body>
<div class="app" id="app"></div>

<script>
/* ---------- Config ---------- */
const COMPANIES = {
  saintlukes: {id:'saintlukes', name:"Saint Luke's", short:'Hospital', color:'#1D4E7A', initial:'SL'},
  baywatch:   {id:'baywatch',   name:'911 Baywatch',  short:'Ambulancia', color:'#C1441E', initial:'BW'},
  lovalgo:    {id:'lovalgo',    name:'Lovalgo',       short:'Medicina regenerativa', color:'#8B4F6B', initial:'LV'}
};
pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
const LOGO_DATA_URI = 'data:image/jpeg;base64,';

/* ---------- State ---------- */
let state = {
  view: 'home',
  courses: [],
  loaded: false,
  settings: { scriptUrl: '' },
  settingsLoaded: false,
  settingsTest: null,
  wizard: { step: 1, file: null, fileName: '', extracting:false, text: null, format: null, company: null, generating:false, progressMsg:'', progressPct:0, error:null },
  activeCourseId: null,
  activeModuleIdx: 0,
  activeSlideIdx: 0,
  quizAnswers: {},
  quizSubmitted: false
};

/* ---------- Storage ---------- */
async function loadCourses(){
  try{
    const r = await window.storage.get('courses', false);
    state.courses = r ? JSON.parse(r.value) : [];
  }catch(e){ state.courses = []; }
  state.loaded = true;
  render();
}
async function saveCourses(){
  try{ await window.storage.set('courses', JSON.stringify(state.courses), false); }
  catch(e){ console.error('storage error', e); }
}

async function loadSettings(){
  try{
    const r = await window.storage.get('settings', false);
    if(r) state.settings = JSON.parse(r.value);
  }catch(e){ /* no settings saved yet */ }
  state.settingsLoaded = true;
}
async function saveSettings(){
  try{ await window.storage.set('settings', JSON.stringify(state.settings), false); }
  catch(e){ console.error('storage error', e); }
}

/* ---------- Claude API ---------- */
async function callClaude(systemPrompt, userPrompt){
  if(!state.settings.scriptUrl){
    throw new Error('No has configurado la URL del backend. Ve a Configuración y pega la URL de tu Apps Script.');
  }
  const res = await fetch(state.settings.scriptUrl, {
    method:'POST',
    headers:{'Content-Type':'text/plain;charset=utf-8'},
    body: JSON.stringify({
      max_tokens:1200,
      system: systemPrompt,
      prompt: userPrompt
    })
  });
  if(!res.ok){ throw new Error('El backend respondió con error ' + res.status); }
  const data = await res.json();
  if(data.error){ throw new Error(data.error); }
  if(!data.text){ throw new Error('Respuesta vacía del backend'); }
  return data.text;
}
function parseJsonLoose(text){
  const cleaned = text.replace(/```json/g,'').replace(/```/g,'').trim();
  return JSON.parse(cleaned);
}

/* ---------- Text extraction ---------- */
async function extractText(file){
  const name = file.name.toLowerCase();
  if(name.endsWith('.pdf')){
    const buf = await file.arrayBuffer();
    const pdf = await pdfjsLib.getDocument({data:buf}).promise;
    let text = '';
    const maxPages = Math.min(pdf.numPages, 30);
    for(let i=1;i<=maxPages;i++){
      const page = await pdf.getPage(i);
      const content = await page.getTextContent();
      text += content.items.map(it => it.str).join(' ') + '\n';
    }
    return text;
  } else if(name.endsWith('.docx')){
    const buf = await file.arrayBuffer();
    const result = await mammoth.extractRawText({arrayBuffer:buf});
    return result.value;
  } else {
    return await file.text();
  }
}

/* ---------- Generation ---------- */
async function generateCourse(){
  const w = state.wizard;
  w.generating = true; w.error = null;
  const company = COMPANIES[w.company];
  const sourceExcerpt = w.text.slice(0, 12000);

  try{
    if(w.format === 'curso'){
      w.progressMsg = 'Analizando el documento y diseñando la estructura del curso…';
      w.progressPct = 8;
      render();

      const outlineSys = 'Eres un diseñador instruccional que crea cursos corporativos de capacitación para personal de un grupo hospitalario en México. Respondes ÚNICAMENTE con JSON válido, sin texto adicional, sin backticks.';
      const outlinePrompt = `A partir del siguiente documento fuente, diseña un curso interactivo en español para la empresa "${company.name}" (${company.short}).
Devuelve un JSON con esta forma exacta:
{"title": "...", "description": "una frase", "modules": [{"title":"...", "summary":"..."}], "quiz": [{"question":"...", "options":["...","...","...","..."], "correctIndex": 0}]}
Reglas: entre 4 y 6 módulos. El "summary" de cada módulo debe tener 1-2 frases que indiquen qué debe redactarse en ese módulo. El quiz debe tener exactamente 5 preguntas de opción múltiple con 4 opciones cada una, basadas en el contenido del documento.

DOCUMENTO FUENTE:
"""${sourceExcerpt}"""`;

      const outlineRaw = await callClaude(outlineSys, outlinePrompt);
      const outline = parseJsonLoose(outlineRaw);

      const modules = [];
      const total = outline.modules.length;
      for(let i=0;i<total;i++){
        const m = outline.modules[i];
        w.progressMsg = `Redactando módulo ${i+1} de ${total}: "${m.title}"`;
        w.progressPct = 15 + Math.round((i/total)*75);
        render();

        const modSys = 'Eres un redactor de contenido de capacitación corporativa en español, claro y directo, para personal de salud y administrativo. Devuelves solo el contenido pedido, sin JSON, sin encabezados markdown tipo #, usando como mucho negritas con ** y listas con guiones.';
        const modPrompt = `Redacta el contenido del módulo "${m.title}" para el curso "${outline.title}" (empresa: ${company.name}).
Enfoque del módulo: ${m.summary}
Extensión: 150-220 palabras, en párrafos cortos y, si aplica, una lista con viñetas de puntos clave.
Basa el contenido en este documento fuente (usa solo lo relevante para este módulo):
"""${sourceExcerpt}"""`;

        const content = await callClaude(modSys, modPrompt);
        modules.push({title: m.title, content: content.trim()});
      }

      w.progressMsg = 'Finalizando curso…';
      w.progressPct = 98;
      render();

      const course = {
        id: 'c_' + Date.now(),
        type: 'curso',
        title: outline.title,
        description: outline.description,
        company: w.company,
        modules,
        quiz: outline.quiz,
        sourceFileName: w.fileName,
        status: 'listo',
        createdAt: new Date().toISOString()
      };
      state.courses.unshift(course);
      await saveCourses();
      w.generating = false;
      state.activeCourseId = course.id;
      state.activeModuleIdx = 0;
      state.quizAnswers = {};
      state.quizSubmitted = false;
      state.view = 'courseDetail';
      resetWizard();
      render();

    } else {
