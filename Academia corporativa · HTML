function escapeHtml(s){ return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

function sanitizeFilename(s){ return (s||'curso').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9 \-]/gi,'').trim().replace(/\s+/g,'_').slice(0,60) || 'curso'; }

function buildFullDocumentHTML(c, co){
  let bodyHtml = '';
  if(c.type === 'curso'){
    bodyHtml = c.modules.map((m,i)=>`<h2>${i+1}. ${escapeHtml(m.title)}</h2>${renderBody(m.content)}`).join('');
    const quizHtml = '<h2>Evaluación final</h2>' + c.quiz.map((q,i)=>{
      const opts = q.options.map((o,oi)=>`<li${oi===q.correctIndex?' style="font-weight:bold;"':''}>${escapeHtml(o)}${oi===q.correctIndex?' &#10003;':''}</li>`).join('');
      return `<p><strong>${i+1}. ${escapeHtml(q.question)}</strong></p><ul>${opts}</ul>`;
    }).join('');
    bodyHtml += quizHtml;
  } else {
    bodyHtml = c.slides.map((s,i)=>{
      const bullets = (s.bullets && s.bullets.length) ? '<ul>' + s.bullets.map(b=>`<li>${escapeHtml(b)}</li>`).join('') + '</ul>' : '';
      return `<h2>${i+1}. ${escapeHtml(s.title)}</h2>${bullets}`;
    }).join('');
  }
  return `<!DOCTYPE html><html><head><meta charset="utf-8"><title>${escapeHtml(c.title)}</title>
<style>
  body{font-family:Georgia, 'Times New Roman', serif; color:#12181C; max-width:680px; margin:40px auto; line-height:1.6; padding:0 24px;}
  h1{font-size:25px;margin-bottom:4px;}
  .meta{color:#556063;font-size:12.5px;margin-bottom:8px;}
  .desc{color:#333;font-size:14px;margin-bottom:28px;}
  h2{font-size:17px;margin-top:30px;margin-bottom:10px;border-bottom:1px solid #DCE4E2;padding-bottom:6px;}
  ul{padding-left:20px;} li{margin-bottom:6px;}
  p{margin:0 0 12px 0;font-size:13.5px;}
  @media print{ body{margin:0 auto;} }
</style></head><body>
<h1>${escapeHtml(c.title)}</h1>
<div class="meta">${escapeHtml(co.name)} &middot; ${c.type==='curso' ? 'Curso interactivo' : 'Presentación'} &middot; Generado con NEXOSalud by RHINOBUILD</div>
<div class="desc">${escapeHtml(c.description||'')}</div>
${bodyHtml}
</body></html>`;
}

function downloadAsDoc(c, co){
  const html = buildFullDocumentHTML(c, co);
  const blob = new Blob(['\ufeff', html], {type:'application/msword'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = sanitizeFilename(c.title) + '.doc';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  setTimeout(()=>URL.revokeObjectURL(url), 2000);
}

function downloadAsPdf(c, co){
  const html = buildFullDocumentHTML(c, co);
  const iframe = document.createElement('iframe');
  iframe.style.position = 'fixed';
  iframe.style.right = '0';
  iframe.style.bottom = '0';
  iframe.style.width = '0';
  iframe.style.height = '0';
  iframe.style.border = '0';
  document.body.appendChild(iframe);
  const doc = iframe.contentWindow.document;
  doc.open();
  doc.write(html);
  doc.close();
  setTimeout(()=>{
    iframe.contentWindow.focus();
    iframe.contentWindow.print();
    setTimeout(()=>{ if(iframe.parentNode) document.body.removeChild(iframe); }, 1200);
  }, 350);
}

