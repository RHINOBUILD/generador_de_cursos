    ]));
  }

  else if(w.step === 3){
    const co = COMPANIES[w.company];
    wrap.appendChild(el('div',{class:'step-label'},['PASO 3 DE 3']));
    wrap.appendChild(el('div',{class:'step-title'},['Revisa y convierte']));
    const box = el('div',{class:'review-box'},[
      el('div',{class:'review-row'},[el('span',{class:'k'},['Documento']), el('span',{class:'v'},[w.fileName])]),
      el('div',{class:'review-row'},[el('span',{class:'k'},['Formato']), el('span',{class:'v'},[w.format==='curso'?'Curso interactivo':'Presentación'])]),
      el('div',{class:'review-row'},[el('span',{class:'k'},['Empresa']), el('span',{class:'v'},[co.name])]),
    ]);
    wrap.appendChild(box);
    if(w.error) wrap.appendChild(el('div',{class:'err-box'},[w.error]));
    wrap.appendChild(el('div',{class:'wizard-actions'},[
      el('button',{class:'btn btn-ghost', onclick:()=>{w.step=2;render();}},['Atrás']),
      el('button',{class:'btn btn-primary', onclick:()=>generateCourse()},['Convertir documento'])
    ]));
  }

  return wrap;
}

async function handleFile(file){
  if(!file) return;
  const w = state.wizard;
  w.file = file; w.fileName = file.name; w.text = null; w.extracting = true; w.error = null;
  render();
  try{
    const text = await extractText(file);
    if(!text || text.trim().length < 30){
      w.error = 'No se pudo extraer texto suficiente de este documento. Prueba con otro archivo.';
      w.file = null; w.fileName='';
    } else {
      w.text = text;
    }
  }catch(e){
    console.error(e);
    w.error = 'No se pudo leer el archivo (' + e.message + ').';
    w.file = null; w.fileName = '';
  }
  w.extracting = false;
  render();
}

/* ---------- Course detail ---------- */
function renderCourseDetail(){
  const c = state.courses.find(x=>x.id===state.activeCourseId);
  if(!c){ state.view='courses'; return el('div'); }
  const co = COMPANIES[c.company];
  const wrap = el('div', {});
  wrap.appendChild(el('div',{class:'course-head'},[
    chip(co, 44),
    el('div',{class:'grow'},[
      el('h1',{class:'title'},[c.title]),
      el('div',{class:'meta'},[`${co.name} · ${c.type==='curso'?'Curso interactivo':'Presentación'} · generado a partir de "${c.sourceFileName}"`])
    ]),
    el('div',{class:'download-group'},[
      el('button',{class:'btn-dl', onclick:()=>downloadAsDoc(c, co)},['⬇ Word (.doc)']),
      el('button',{class:'btn-dl', onclick:()=>downloadAsPdf(c, co)},['⬇ PDF'])
    ])
  ]));

  if(c.type === 'curso'){
    wrap.appendChild(renderCourseBody(c, co));
  } else {
    wrap.appendChild(renderSlideDeck(c, co));
  }
  return wrap;
}

function renderCourseBody(c, co){
  const body = el('div',{class:'course-body'});
  const isQuiz = state.activeModuleIdx >= c.modules.length;
  const navBtns = c.modules.map((m,i)=>
    el('button',{class:'module-nav-btn' + (state.activeModuleIdx===i?' active':'')})
  );
  const nav = el('div',{class:'module-nav'});
  c.modules.forEach((m,i)=>{
    nav.appendChild(el('button',{class: state.activeModuleIdx===i && !isQuiz ? 'active':'', onclick:()=>{state.activeModuleIdx=i; render();}},[
      el('span',{class:'num'},[String(i+1).padStart(2,'0')]), m.title
    ]));
  });
  nav.appendChild(el('button',{class: isQuiz ? 'active':'', onclick:()=>{state.activeModuleIdx=c.modules.length; render();}},[
    el('span',{class:'num'},['✓']), 'Evaluación final'
  ]));
  body.appendChild(nav);

  const pane = el('div',{class:'content-pane'});
  if(!isQuiz){
    const m = c.modules[state.activeModuleIdx];
    pane.appendChild(el('h3',{},[m.title]));
    pane.appendChild(el('div',{class:'body-text', html: renderBody(m.content)}));
    pane.appendChild(el('div',{class:'content-nav'},[
      el('button',{class:'btn btn-ghost', disabled: state.activeModuleIdx===0 ? true:undefined,
        onclick:()=>{ if(state.activeModuleIdx>0){state.activeModuleIdx--; render();} }},['← Anterior']),
      el('button',{class:'btn btn-primary',
        onclick:()=>{ state.activeModuleIdx++; render(); }},[state.activeModuleIdx===c.modules.length-1 ? 'Ir a la evaluación →' : 'Siguiente módulo →'])
    ]));
  } else {
    pane.appendChild(el('h3',{},['Evaluación final']));
    pane.appendChild(renderQuiz(c));
  }
  body.appendChild(pane);
  return body;
}

function renderQuiz(c){
  const wrap = el('div', {});
  if(state.quizSubmitted){
    let correct = 0;
    c.quiz.forEach((q,i)=>{ if(state.quizAnswers[i]===q.correctIndex) correct++; });
    const pct = Math.round((correct/c.quiz.length)*100);
    const res = el('div',{class:'quiz-result'},[
      el('div',{class:'score'},[`${correct}/${c.quiz.length}`]),
      el('div',{style:'font-size:13px;color:var(--ink-soft);margin-top:6px'},[`${pct}% de respuestas correctas`]),
    ]);
    wrap.appendChild(res);
    wrap.appendChild(el('div',{style:'margin-top:16px'}, c.quiz.map((q,i)=>{
      const box = el('div',{class:'quiz-q'});
      box.appendChild(el('div',{class:'qtext'},[`${i+1}. ${q.question}`]));
      q.options.forEach((opt,oi)=>{
        let cls = 'quiz-opt';
        if(oi===q.correctIndex) cls += ' correct';
        else if(state.quizAnswers[i]===oi) cls += ' wrong';
        box.appendChild(el('div',{class:cls},[opt]));
      });
      return box;
    })));
    wrap.appendChild(el('button',{class:'btn btn-ghost', style:'margin-top:16px', onclick:()=>{state.quizAnswers={};state.quizSubmitted=false;render();}},['Reintentar']));
    return wrap;
  }

  c.quiz.forEach((q,i)=>{
    const box = el('div',{class:'quiz-q'});
    box.appendChild(el('div',{class:'qtext'},[`${i+1}. ${q.question}`]));
    q.options.forEach((opt,oi)=>{
      box.appendChild(el('div',{class:'quiz-opt' + (state.quizAnswers[i]===oi?' picked':''), onclick:()=>{state.quizAnswers[i]=oi;render();}},[opt]));
    });
    wrap.appendChild(box);
  });
  const allAnswered = c.quiz.every((q,i)=> state.quizAnswers[i] !== undefined);
  wrap.appendChild(el('button',{class:'btn btn-primary', disabled: !allAnswered ? true:undefined, style:'margin-top:8px',
    onclick:()=>{ if(allAnswered){state.quizSubmitted=true; render();} }},['Enviar respuestas']));
  return wrap;
}

function renderSlideDeck(c, co){
  const wrap = el('div', {style:'max-width:720px'});
  const i = state.activeSlideIdx;
  const s = c.slides[i];
  const frame = el('div',{class:'slide-frame'});
  frame.appendChild(el('div',{class:'bar', style:`background:${co.color}`}));
  frame.appendChild(el('h3',{},[s.title]));
  if(s.bullets && s.bullets.length){
    frame.appendChild(el('ul',{}, s.bullets.map(b=>el('li',{},[b]))));
  }
  wrap.appendChild(frame);
  wrap.appendChild(el('div',{class:'slide-controls'},[
    el('button',{class:'icon-btn', disabled: i===0?true:undefined, onclick:()=>{state.activeSlideIdx--; render();}},['←']),
    el('div',{class:'idx'},[`${i+1} / ${c.slides.length}`]),
    el('button',{class:'icon-btn', disabled: i===c.slides.length-1?true:undefined, onclick:()=>{state.activeSlideIdx++; render();}},['→'])
  ]));
  return wrap;
}

/* ---------- Init ---------- */
(async function init(){
  await Promise.all([loadSettings(), (async()=>{
    try{
      const r = await window.storage.get('courses', false);
      state.courses = r ? JSON.parse(r.value) : [];
    }catch(e){ state.courses = []; }
  })()]);
  state.loaded = true;
  render();
})();
</script>
</body>
